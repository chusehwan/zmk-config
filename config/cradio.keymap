#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>


//╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
//│  Q    0  │  W    1  │  E   2   │  R   3   │  T   4   │   │  Y   5   │  U   6   │  I   7   │  O   8   │  P   9   │
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//│  A    10 │  S    11 │  D   12  │  F   13  │  G   14  │   │  H   15  │  J   16  │  K   17  │  L   18  │ ' "  19  │
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//│  Z    20 │  X    21 │  C   22  │  V   23  │  B   24  │   │  N   25  │  M   26  │ , <  27  │ . >  28  │ / ?  29  │
//╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
//                                 │      30  │      31  │   │      32  │      33  │
//                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯

/ {
    macros {
        pl_col: pl_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT>;
        };

        pl_sort: pl_sort {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&kp DOT &kp S &kp O &kp R &kp T &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT>;
        };

        pl_select: pl_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&kp DOT &kp S &kp E &kp L &kp E &kp C &kp T>
                , <&kp LPAR &kp LBKT &kp SQT &kp SQT &kp RBKT &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_with: pl_with {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&kp DOT &kp W &kp I &kp T &kp H &kp UNDER &kp C &kp O &kp L &kp U &kp M &kp N &kp S>
                , <&kp LPAR &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR> 
                , <&kp SQT &kp SQT &kp RPAR &kp RPAR>      
                , <&kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_filter: pl_filter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings
                = <&kp DOT &kp F &kp I &kp L &kp T &kp E &kp R>
                , <&kp LPAR &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR>
                , <&kp SQT &kp SQT &kp RPAR &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_unique: pl_unique {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp DOT &kp U &kp N &kp I &kp Q &kp U &kp E &kp LPAR &kp RPAR>;
        };

        pl_exclude: pl_exclude {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp DOT &kp S &kp E &kp L &kp E &kp C &kp T &kp LPAR>            
                , <&kp P &kp L &kp DOT &kp A &kp L &kp L &kp LPAR &kp RPAR &kp DOT>  
                , <&kp E &kp X &kp C &kp L &kp U &kp D &kp E &kp LPAR>               
                , <&kp SQT &kp SQT &kp RPAR &kp RPAR>                                
                , <&kp LEFT &kp LEFT>;  
        };

        pl_agg: pl_agg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp DOT &kp G &kp R &kp O &kp U &kp P &kp UNDER &kp B &kp Y &kp LPAR &kp SQT &kp SQT &kp RPAR>
                    , <&kp DOT &kp A &kp G &kp G &kp LPAR>                                                         
                    , <&kp EQUAL &kp SPACE &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR &kp RPAR> 
                    , <&kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT 
                        &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_not_null: pl_not_null {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp DOT &kp I &kp S &kp UNDER &kp N &kp O &kp T &kp UNDER &kp N &kp U &kp L &kp L &kp LPAR &kp RPAR>,
                    <&kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT>,
                    <&macro_press &kp LSHFT>,
                    <&kp RIGHT &kp RIGHT &kp RIGHT &kp RIGHT>,
                    <&macro_release &kp LSHFT>;
        };

        pl_collect: pl_collect {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp DOT &kp C &kp O &kp L &kp L &kp E &kp C &kp T &kp LPAR &kp RPAR>,
                    <&kp LEFT>;
        };

        pl_head: pl_head {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp DOT &kp H &kp E &kp A &kp D &kp LPAR &kp RPAR>,
                    <&kp LEFT>;
        };

        pl_set_rows: pl_set_rows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings 
                = <&kp P &kp L &kp DOT &kp C &kp O &kp N &kp F &kp I &kp G &kp DOT &kp S &kp E &kp T &kp UNDER &kp T &kp B &kp L &kp UNDER &kp R &kp O &kp W &kp S &kp LPAR &kp RPAR>
                , <&kp LEFT>;
};
    };

    combos {
        compatible = "zmk,combos";
        
        // k + l = ENTER
        combo_enter {
            timeout-ms = <50>;          // 동시에 눌러야 하는 제한 시간 (ms)
            key-positions = <17 18>;   // K와 L의 물리적 위치 번호
            bindings = <&kp ENTER>;     // 실행할 키
        };

         // j + k = BACKSPACE 
        combo_backspace {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

         // w + e = esc 
        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        }; 

        // w + t = 윈도우 + 탭    
        combo_win_tab {
            timeout-ms = <50>;
            key-positions = <1 4>; // W(1)와 T(4)의 위치 번호
            bindings = <&kp LGUI(TAB)>; // 윈도우 + 탭 실행
        };


        // f + p  = pl.col('')
        combo_plcol {
            timeout-ms = <50>;
            key-positions = <13 9>; 
            bindings = <&pl_col>;   
        };

        // f + u = .unique()
        combo_pluniq {
            timeout-ms = <50>;
            key-positions = <13 6>; 
            bindings = <&pl_unique>;   
        };

        // f + n = .is_not_null()
        combo_plnotnull {
            timeout-ms = <50>;
            key-positions = <13 25>; 
            bindings = <&pl_not_null>;   
        };    

        // f + h = .head()
        combo_plhead {
            timeout-ms = <50>;
            key-positions = <13 15>; 
            bindings = <&pl_head>;   
        }; 

        // j + s = .select([''])
        combo_plselect {
            timeout-ms = <50>;
            key-positions = <16 11>; 
            bindings = <&pl_select>;   
        };    

        // j + e = .select(pl.all().exclude(''))
        combo_plexclude {
            timeout-ms = <50>;
            key-positions = <16 2>; 
            bindings = <&pl_exclude>;   
        };   

         // j + a = .sort()
        combo_plsort {
            timeout-ms = <50>;
            key-positions = <16 10>; 
            bindings = <&pl_sort>;   
        };       

         // j + w = .with_columns(pl.col(''))
        combo_plwith {
            timeout-ms = <50>;
            key-positions = <16 1>; 
            bindings = <&pl_with>;   
        };  

         // j + c = .collect()
        combo_plcollect {
            timeout-ms = <50>;
            key-positions = <16 22>; 
            bindings = <&pl_collect>;   
        };  

         // j + f = .filter(pl.col(''))
        combo_plfilter {
            timeout-ms = <50>;
            key-positions = <16 13>; 
            bindings = <&pl_filter>;   
        };  

         // j + g = .group_by('').agg( = pl.col(''))
        combo_plgroup {
            timeout-ms = <50>;
            key-positions = <16 14>; 
            bindings = <&pl_agg>;   
        };  

         // j + r = pl.Config.set_tbl_rows() 
        combo_plsetrow {
            timeout-ms = <50>;
            key-positions = <3 16>; 
            bindings = <&pl_set_rows>;   
        };  
    };

    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        // K 탭 댄스
        k_par: k_parenthesis {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp K>, <&kp LPAR>, <&kp LBKT>, <&kp LBRC>;
        };

        k_alt_dance: k_alt_dance {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&k_par>;
        };

        // L 탭 댄스
        l_par: l_parenthesis {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp L>, <&kp RPAR>, <&kp RBKT>, <&kp RBRC>;
        };

        l_shft_dance: l_shft_dance {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&l_par>;
        };

        // 따옴표/콜론 탭 댄스 (추가됨)
        col_sem_dance: col_sem_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SQT>, <&kp COLON>, <&kp SEMI>;
        };

        // 따옴표 홀드탭 (추가됨)
        sqt_ctrl_dance: sqt_ctrl_dance {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&col_sem_dance>;
        };

        t_tilde: t_tilde {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp T>, <&kp TILDE>;
        };

        b_bang_bslsh: b_bang_bslsh {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp B>, <&kp EXCL>, <&kp BSLH>;
        };

        // 특수문자 : s, #
        s_sharp: s_sharp {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp S>, <&kp HASH>;
        };

        s_shft: s_shft {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&s_sharp>;
        };

        // 특수문자 : d, $
        d_dollor: d_dollor {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp D>, <&kp DLLR>;
        };

        d_alt: d_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&d_dollor>;
        };

        // 특수문자 : caret, ^
        c_car: c_car {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C>, <&kp CARET>;
        };

        // 특수문자 : n, &
        n_nd: n_nd {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N>, <&kp AMPS>;
        };

        // 특수문자 : a, 애스터리스크, 앳(골뱅이)
        a_aster: a_aster {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp A>, <&kp ASTRK>, <&kp AT>;
        };

        a_ctrl: a_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&a_aster>; // &kp는 첫 번째 인자(LCTRL)를 받음
        };

        // 특수문자 : h, 하이푼
        h_hyp: h_hyp {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp H>, <&kp MINUS>;
        };

        // 특수문자 : u, 언더하이푼
        u_undrhyp: u_undrhyp {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp U>, <&kp UNDER>;
        };

        // 특수문자 : e, 이콜
        e_eql: e_eql {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp E>, <&kp EQUAL>;
        };

        // 특수문자 : p, 플러스, 퍼센트
        p_plus_percent: p_plus_percent {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp P>, <&kp PLUS>, <&kp PRCNT>;
        };

        // 특수문자 : o, 오얼 파이프
        o_or: o_or {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp O>, <&kp PIPE>;
        };

    }; // behaviors 블록 전체 닫기

    keymap {
        compatible = "zmk,keymap";
        default_layer_0 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  E       │  R       │  T       │   │  Y       │  U       │  I       │  O       │  P       │
            &kp Q     &ht LGUI W   &e_eql     &kp R     &t_tilde        &kp Y   &u_undrhyp    &kp I      &o_or    &p_plus_percent
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  S       │  D       │  F       │  G       │   │  H       │  J       │  K       │  L       │ ' "      │
       &a_ctrl LCTRL 0 &s_shft LSHFT 0 &d_alt LALT 0 &kp F &kp G        &h_hyp    &kp J   &k_alt_dance RALT 0 &l_shft_dance RSHFT 0 &sqt_ctrl_dance RCTRL 0
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Z       │  X       │  C       │  V       │  B       │   │  N       │  M       │ , <      │ . >      │ / ?      │
              &kp Z    &kp X      &c_car      &kp V    &b_bang_bslsh   &n_nd      &kp M      &kp COMMA  &kp DOT    &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                              &mo 2      &mo 1        &lt 3 SPACE &lt 4 BSPC
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        
        direction_layer_1 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │ DELETE   │ HOME     │   UP     │    END   │ INSERT   │
            &trans      &trans     &trans     &trans    &trans         &kp DEL    &kp HOME    &kp UP     &kp END    &kp INS 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │ SCROL UP │ LEFT     │ DOWN     │ RIGHT    │  TAB     │
            &trans      &trans     &tog 4     &tog 3     &tog 5      &msc SCRL_UP &kp LEFT   &kp DOWN   &kp RIGHT   &kp TAB
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │ SCROL DN │ PG_UP    │          │ PG_DN    │ CAPS     │
             &trans    &trans      &trans   &trans      &trans     &msc SCRL_DOWN &kp PG_UP   &trans    &kp PG_DN  &kp CAPS
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans          &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        number_layer_2 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │    7     │    8     │    9     │          │
             &trans    &trans     &trans     &trans     &trans          &trans    &kp N7     &kp N8     &kp N9     &trans 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    4     │    5     │    6     │    0     │
            &trans     &trans     &kp N5     &tog 3     &trans          &trans    &kp N4     &kp N5     &kp N6     &kp N0
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    1     │    2     │    3     │          │
             &trans    &trans     &trans     &trans     &trans          &trans    &kp N1     &kp N2     &kp N3     &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        function_layer_3 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │  vol dn  │   mute   │  vol up  │          │   │          │    f7    │     f8   │    f9    │    f11   │
             &trans   &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP  &trans      &trans    &kp F7     &kp F8     &kp F9     &kp F11 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │ alt + f4 │    f4    │     f5   │    f6    │    f10   │
            &trans     &trans     &trans    &trans      &trans       &kp LA(F4)    &kp F4     &kp F5     &kp F6     &kp F10
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │   prev   │  stop    │  next    │          │   │          │    f1    │     f2   │    f3    │    f12   │
             &trans   &kp C_PREV  &kp C_PP  &kp C_NEXT    &trans         &trans    &kp F1     &kp F2     &kp F3     &kp F12
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &to 0       &to 0         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        mouse_layer_4 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ same like right     │          │          │          │   │          │  L CLICK │    UP    │  R CLICK │          │
             &trans   &mkp LCLK  &mmv MOVE_UP &mkp RCLK &trans           &trans   &mkp LCLK  &mmv MOVE_UP &mkp RCLK &trans 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │  SCRL UP │    LEFT  │    DOWN  │   RIGHT  │          │
             &msc SCRL_UP &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans        &msc SCRL_UP &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │ SCRL DN  │ SCRL LEFT│          │SCRL RIGHT│          │
             &msc SCRL_DOWN &msc SCRL_LEFT  &trans  &msc SCRL_RIGHT  &trans        &msc SCRL_DOWN &msc SCRL_LEFT  &trans  &msc SCRL_RIGHT  &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &to 0       &to 0         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        admin_layer_5 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ RESET    │          │          │          │          │   │          │          │          │          │  RESET   │
           &sys_reset  &trans     &trans     &trans     &trans          &trans     &trans     &trans     &trans    &sys_reset
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│BOOTLOADER│          │          │          │          │   │          │PROFILE 0 │PROFILE 1 │PROFILE 2 │BOOTLOADER│
          &bootloader  &trans     &trans     &trans      &trans       &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bootloader
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │PROFILE 3 │ PROFILE 4│          │          │
            &trans     &trans     &trans    &bt BT_CLR   &trans         &trans  &bt BT_SEL 3 &bt BT_SEL 4 &trans     &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                              &to 0      &to 0         &to 0       &to 0
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
