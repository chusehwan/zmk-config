    #include <behaviors.dtsi>
    #include <dt-bindings/zmk/keys.h>
    #include <dt-bindings/zmk/bt.h>
    #define ZMK_POINTING_DEFAULT_MOVE_VAL 780  // default: 600
    #define ZMK_POINTING_DEFAULT_SCRL_VAL 30    // default: 10

    #include <dt-bindings/zmk/pointing.h>




    //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
    //│  Q    0  │  W    1  │  E   2   │  R   3   │  T   4   │   │  Y   5   │  U   6   │  I   7   │  O   8   │  P   9   │
    //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    //│  A    10 │  S    11 │  D   12  │  F   13  │  G   14  │   │  H   15  │  J   16  │  K   17  │  L   18  │ ' "  19  │
    //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    //│  Z    20 │  X    21 │  C   22  │  V   23  │  B   24  │   │  N   25  │  M   26  │ , <  27  │ . >  28  │ / ?  29  │
    //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
    //                                 │      30  │      31  │   │      32  │      33  │
    //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯



    / {
    macros {
        pl_col: pl_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT>;
        };
        
        pl_sort: pl_sort {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp DOT &kp S &kp O &kp R &kp T &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT>;
        };

        pl_select: pl_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp DOT &kp S &kp E &kp L &kp E &kp C &kp T>
                , <&kp LPAR &kp LBKT &kp SQT &kp SQT &kp RBKT &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_with: pl_with {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings 
                = <&macro_pause_for_release>
                // 1. 전체 문장을 한 번에 입력 (신호 뭉침 방지)
                , <&kp DOT &kp W &kp I &kp T &kp H &kp UNDER &kp C &kp O &kp L &kp U &kp M &kp N &kp S 
                &kp LPAR &kp EQUAL &kp SPACE &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR &kp RPAR>
                // 3. 단어 단위로 큼직하게 이동 (Ctrl + Left)
                , <&kp LC(LEFT)>  // pl.col('') 끝으로 이동
                , <&kp LC(LEFT)>  // pl 앞(공백)으로 이동
                , <&kp LC(LEFT)>  // = 앞(공백)으로 이동
                // 4. 미세 조정 (필요시 한두 칸만)
                , <&kp LEFT>
                ;
        };



        pl_filter: pl_filter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp DOT &kp F &kp I &kp L &kp T &kp E &kp R>
                , <&kp LPAR &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR>
                , <&kp SQT &kp SQT &kp RPAR &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_unique: pl_unique {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp U &kp N &kp I &kp Q &kp U &kp E &kp LPAR &kp RPAR>;
        };

        pl_exclude: pl_exclude {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp S &kp E &kp L &kp E &kp C &kp T &kp LPAR>            
                , <&kp P &kp L &kp DOT &kp A &kp L &kp L &kp LPAR &kp RPAR &kp DOT>  
                , <&kp E &kp X &kp C &kp L &kp U &kp D &kp E &kp LPAR>               
                , <&kp SQT &kp SQT &kp RPAR &kp RPAR>                                
                , <&kp LEFT &kp LEFT &kp LEFT>;  
        };

        pl_not_null: pl_not_null {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp DOT &kp I &kp S &kp UNDER &kp N &kp O &kp T &kp UNDER &kp N &kp U &kp L &kp L &kp LPAR &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT> 
                , <&kp LS(LEFT) &kp LS(LEFT) &kp LS(LEFT) &kp LS(LEFT)>           
                ;
        };


        pl_collect: pl_collect {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp C &kp O &kp L &kp L &kp E &kp C &kp T &kp LPAR &kp RPAR>,
                    <&kp LEFT>;
        };

        pl_head: pl_head {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp H &kp E &kp A &kp D &kp LPAR &kp RPAR>,
                    <&kp LEFT>;
        };

        pl_set_rows: pl_set_rows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp P &kp L &kp DOT &kp LS(C) &kp O &kp N &kp F &kp I &kp G &kp DOT &kp S &kp E &kp T &kp UNDER &kp T &kp B &kp L &kp UNDER &kp R &kp O &kp W &kp S &kp LPAR &kp RPAR>
                , <&kp LEFT>;
        };

        pl_group: pl_group {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp DOT &kp G &kp R &kp O &kp U &kp P &kp UNDER &kp B &kp Y &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp DOT &kp A &kp G &kp G &kp LPAR &kp EQUAL &kp SPACE &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT> 
                ; // 총 22번 왼쪽으로 이동하여 .group_by(' 뒤에 커서 위치
        };


    };
    combos {
        compatible = "zmk,combos";
        // k + l = ENTER
        combo_enter {
            timeout-ms = <30>;          // 동시에 눌러야 하는 제한 시간 (ms)
            key-positions = <17 18>;   // K와 L의 물리적 위치 번호
            bindings = <&kp ENTER>;     // 실행할 키
        };

            // j + k = BACKSPACE 
        combo_backspace {
            timeout-ms = <30>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

            // h + j = cntrl + BACKSPACE 
        combo_backspace_ctrl {
            timeout-ms = <30>;
            key-positions = <16 17 18>;
            bindings = <&kp LC(BSPC)>;
        };

            // w + e = esc 
        combo_esc {
            timeout-ms = <30>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        }; 

            // k + w = won 
        combo_won {
            timeout-ms = <30>;
            key-positions = <17 1>;
            bindings = <&kp BSLH>;
        }; 

            // k + r = ratio
        combo_ratio {
            timeout-ms = <30>;
            key-positions = <17 3>;
            bindings = <&kp PRCNT>;
        }; 

            // k + t = tilde
        combo_tilde {
            timeout-ms = <30>;
            key-positions = <17 4>;
            bindings = <&kp TILDE>;
        }; 

            // k + a = asterisk
        combo_aster {
            timeout-ms = <30>;
            key-positions = <17 10>;
            bindings = <&kp ASTRK>;
        }; 

            // k + s = sharp
        combo_sharp {
            timeout-ms = <30>;
            key-positions = <17 11>;
            bindings = <&kp HASH>;
        }; 

            // d + m = money
        combo_dollor {
            timeout-ms = <30>;
            key-positions = <12 26>;
            bindings = <&kp DLLR>;
        }; 

            // k + e = equal
        combo_eql {
            timeout-ms = <30>;
            key-positions = <17 2>;
            bindings = <&kp EQUAL>;
        }; 

        // k + g = golbange
        combo_at {
            timeout-ms = <30>;
            key-positions = <17 14>;
            bindings = <&kp AT>;
        }; 

        // k + c = caret
        combo_caret {
            timeout-ms = <30>;
            key-positions = <17 22>;
            bindings = <&kp CARET>;
        }; 
        
        // k + b = bang
        combo_bang {
            timeout-ms = <30>;
            key-positions = <17 24>;
            bindings = <&kp EXCL>;
        }; 

        // d + y = grave
        combo_GRAVE {
            timeout-ms = <30>;
            key-positions = <12 5>;
            bindings = <&kp GRAVE>;
        }; 

        // d + u = 중괄호열기
        combo_LBKT {
            timeout-ms = <30>;
            key-positions = <12 6>;
            bindings = <&kp LBKT>;
        }; 

        // d + i = 중괄호닫기
        combo_RBKT {
            timeout-ms = <30>;
            key-positions = <12 7>;
            bindings = <&kp RBKT>;
        }; 

            // d + o = or
        combo_PIPE {
            timeout-ms = <30>;
            key-positions = <12 8>;
            bindings = <&kp PIPE>;
        }; 

            // d + p = plus
        combo_PLUS {
            timeout-ms = <30>;
            key-positions = <12 9>;
            bindings = <&kp PLUS>;
        }; 

            // d + h = hyphen
        combo_MINUS {
            timeout-ms = <30>;
            key-positions = <12 15>;
            bindings = <&kp MINUS>;
        }; 

            // d + l = under 
        combo_UNDER {
            timeout-ms = <30>;
            key-positions = <12 18>;
            bindings = <&kp UNDER>;
        }; 

            // d + j = 소괄호열기
        combo_LPAR {
            timeout-ms = <30>;
            key-positions = <12 16>;
            bindings = <&kp LPAR>;
        }; 

            // d + k = 소괄호 닫기
        combo_RPAR {
            timeout-ms = <30>;
            key-positions = <12 17>;
            bindings = <&kp RPAR>;
        }; 

            // d + ' = colon
        combo_COLON {
            timeout-ms = <30>;
            key-positions = <12 19>;
            bindings = <&kp COLON>;
        }; 

            // d + n = and
        combo_AMPS {
            timeout-ms = <30>;
            key-positions = <12 25>;
            bindings = <&kp AMPS>;
        }; 

            // d + , = 대괄호열기
        combo_LBRC {
            timeout-ms = <30>;
            key-positions = <12 27>;
            bindings = <&kp LBRC>;
        }; 

            // d + . = 대괄호 닫기
        combo_RBRC {
            timeout-ms = <30>;
            key-positions = <12 28>;
            bindings = <&kp RBRC>;
        }; 
        
            // d + : = semicolon
        combo_SEMI {
            timeout-ms = <30>;
            key-positions = <12 29>;
            bindings = <&kp SEMI>;
        }; 

        // f + p  = pl.col('')
        combo_plcol {
            timeout-ms = <30>;
            key-positions = <13 9>; 
            bindings = <&pl_col>;   
        };

        // f + u = .unique()
        combo_pluniq {
            timeout-ms = <30>;
            key-positions = <13 6>; 
            bindings = <&pl_unique>;   
        };

        // f + n = .is_not_null()
        combo_plnotnull {
            timeout-ms = <30>;
            key-positions = <13 25>; 
            bindings = <&pl_not_null>;   
        };    

        // f + h = .head()
        combo_plhead {
            timeout-ms = <30>;
            key-positions = <13 15>; 
            bindings = <&pl_head>;   
        }; 

        // j + s = .select([''])
        combo_plselect {
            timeout-ms = <30>;
            key-positions = <16 11>; 
            bindings = <&pl_select>;   
        };    

        // j + e = .select(pl.all().exclude(''))
        combo_plexclude {
            timeout-ms = <30>;
            key-positions = <16 2>; 
            bindings = <&pl_exclude>;   
        };   

            // j + a = .sort()
        combo_plsort {
            timeout-ms = <30>;
            key-positions = <16 10>; 
            bindings = <&pl_sort>;   
        };       

            // j + w = .with_columns(pl.col(''))
        combo_plwith {
            timeout-ms = <30>;
            key-positions = <16 1>; 
            bindings = <&pl_with>;   
        };  

            // j + c = .collect()
        combo_plcollect {
            timeout-ms = <30>;
            key-positions = <16 22>; 
            bindings = <&pl_collect>;   
        };  

            // j + f = .filter(pl.col(''))
        combo_plfilter {
            timeout-ms = <30>;
            key-positions = <16 13>; 
            bindings = <&pl_filter>;   
        };  

            // j + g = .group_by('').agg( = pl.col(''))
        combo_plgroup {
            timeout-ms = <30>;
            key-positions = <16 14>;  
            bindings = <&pl_group>;   
        };  

            // j + r = pl.Config.set_tbl_rows() 
        combo_plsetrow {
            timeout-ms = <30>;
            key-positions = <3 16>; 
            bindings = <&pl_set_rows>;   
        };  

            // s + d =screen shot 
        combo_screenshot {
            timeout-ms = <30>;
            key-positions = <11 12>; 
            bindings = <&kp LS(LG(S))>;   
        };  

            // left shift + ㅂ = ㅃ 
        combo_shiftq {
            timeout-ms = <30>;
            key-positions = <18 0>; 
            bindings = <&kp LS(Q)>;   
        };  

            // left shift + ㅈ = ㅉ 
        combo_shiftw {
            timeout-ms = <30>;
            key-positions = <18 1>; 
            bindings = <&kp LS(W)>;   
        };  

            // left shift + ㄷ = ㄸ 
        combo_shifte {
            timeout-ms = <30>;
            key-positions = <18 2>; 
            bindings = <&kp LS(E)>;   
        };  

            // left shift + ㄱ = ㄲ 
        combo_shiftr {
            timeout-ms = <30>;
            key-positions = <18 3>; 
            bindings = <&kp LS(R)>;   
        };  

            // left shift + ㅅ = ㅆ 
        combo_shiftt {
            timeout-ms = <30>;
            key-positions = <18 4>; 
            bindings = <&kp LS(T)>;   
        };  
    };
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            // require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        layer_tab: layer_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            // 홀드 시 첫 번째 인자(&mo), 탭 시 두 번째 인자(&to) 실행
            bindings = <&mo>, <&kp>;
        };

        to_mo: to_mo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";    // 짧게 누르기 반응성을 높임
            tapping-term-ms = <200>;     
            bindings = <&mo>, <&to>;     // 순서: [Hold 시 동작], [Tap 시 동작]
        };
    }; 
    keymap {
        compatible = "zmk,keymap";
        default_layer_0 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  E       │  R       │  T       │   │  Y       │  U       │  I       │  O       │  P       │
            &kp Q         &kp W   &kp E     &kp R      &kp T         &kp Y      &kp U        &kp I      &kp O    &kp P
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  S       │  D       │  F       │  G       │   │  H       │  J       │  K       │  L       │ ' "      │
            &ht LCTRL A &ht LSHFT S &ht LALT D &ht LGUI F &kp G       &ht CAPS H  &ht RGUI J &ht LALT K &ht RSHFT L &ht LCTRL SQT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Z       │  X       │  C       │  V       │  B       │   │  N       │  M       │ , <      │ . >      │ / ?      │
            &kp Z        &kp X      &kp C      &kp V    &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                        &to_mo 3 2    &layer_tab 1 TAB  &lt 3 SPACE  &layer_tab 4 RALT
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };                 
        direction_layer_1 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │ DELETE   │          │   UP     │          │ INSERT   │
            &trans      &trans   &msc SCRL_UP &trans       &trans      &kp DEL    &kp PG_UP    &kp UP  &kp PG_DN    &kp INS 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │ LEFT     │ DOWN     │ RIGHT    │          │
            &trans   &trans  &msc SCRL_LEFT &msc SCRL_RIGHT &trans     &kp HOME  &kp LEFT  &kp DOWN   &kp RIGHT   &kp END 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
            &trans     &trans   &msc SCRL_DOWN &trans    &trans         &trans  &msc SCRL_UP &msc SCRL_DOWN &trans &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &trans     &trans         &mkp LCLK  &mkp RCLK
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
        mouse_layer_2 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │          │          │          │          │
        &kp C_MUTE      &trans     &trans     &trans     &trans       &kp LC(W) &kp LC(PG_UP) &mmv MOVE_UP &kp LC(PG_DN) &kp F11
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
        &kp C_VOL_UP  &trans  &msc SCRL_LEFT &msc SCRL_RIGHT &trans &kp LEFT  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp RIGHT 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
        &kp C_VOL_DN &kp C_PREV    &kp C_PP &kp C_NEXT   &trans       &kp LA(LEFT) &msc SCRL_UP &msc SCRL_DOWN &kp F &kp LA(RIGHT)  
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &to 0     &to 0       &mkp LCLK  &mkp RCLK
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };        
        number_layer_3 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │    7     │    8     │    9     │          │
           &kp C_MUTE   &kp F7     &kp F8     &kp F9    &kp F11       &kp MINUS    &kp N7     &kp N8     &kp N9     &kp PLUS 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    4     │    5     │    6     │    0     │
        &ht LCTRL C_VOL_UP &ht LSHFT F4 &ht LALT F5 &kp F6 &kp F10     &trans    &kp N4   &ht LALT N5 &ht RSHFT N6 &ht LCTRL N0
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    1     │    2     │    3     │          │
          &kp C_VOL_DN  &kp F1     &kp F2     &kp F3    &kp F12        &kp ASTRK    &kp N1     &kp N2     &kp N3     &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;

        };
        admin_layer_4 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ RESET    │          │          │          │          │   │          │          │          │          │  RESET   │
            &sys_reset  &trans     &trans     &trans     &trans          &trans     &trans     &trans     &trans    &sys_reset
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│BOOTLOADER│          │          │          │          │   │          │PROFILE 0 │PROFILE 1 │PROFILE 2 │BOOTLOADER│
            &bootloader  &trans     &trans     &trans      &trans       &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bootloader
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │PROFILE 3 │ PROFILE 4│          │          │
            &trans     &trans     &trans    &bt BT_CLR   &trans         &trans  &bt BT_SEL 3 &bt BT_SEL 4 &trans     &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &trans     &trans        &trans     &trans 
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
