#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>




//╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
//│  Q    0  │  W    1  │  E   2   │  R   3   │  T   4   │   │  Y   5   │  U   6   │  I   7   │  O   8   │  P   9   │
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//│  A    10 │  S    11 │  D   12  │  F   13  │  G   14  │   │  H   15  │  J   16  │  K   17  │  L   18  │ ' "  19  │
//├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
//│  Z    20 │  X    21 │  C   22  │  V   23  │  B   24  │   │  N   25  │  M   26  │ , <  27  │ . >  28  │ / ?  29  │
//╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
//                                 │      30  │      31  │   │      32  │      33  │
//                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯

/ {
    macros {
        pl_col: pl_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings
                = <&kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT>;
        };

    };
    combos {
        compatible = "zmk,combos";
        // k + l = ENTER
        combo_enter {
            timeout-ms = <30>;          // 동시에 눌러야 하는 제한 시간 (ms)
            key-positions = <17 18>;   // K와 L의 물리적 위치 번호
            bindings = <&kp ENTER>;     // 실행할 키
        };

         // j + k = BACKSPACE 
        combo_backspace {
            timeout-ms = <30>;
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

         // w + e = esc 
        combo_esc {
            timeout-ms = <30>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        }; 

        // f + p  = pl.col('')
        combo_plcol {
            timeout-ms = <30>;
            key-positions = <13 9>; 
            bindings = <&pl_col>;   
        };

    };
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

   
    }; 
    keymap {
        compatible = "zmk,keymap";
        default_layer_0 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  E       │  R       │  T       │   │  Y       │  U       │  I       │  O       │  P       │
            &kp Q       &kp W       &kp E     &kp R      &kp T         &kp Y      &kp U        &kp I      &kp O    &kp P
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  S       │  D       │  F       │  G       │   │  H       │  J       │  K       │  L       │ ' "      │
              &kp A     &kp S      &kp D      &kp F       &kp G        &kp H       &kp J       &kp K    &kp L     &kp SQT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Z       │  X       │  C       │  V       │  B       │   │  N       │  M       │ , <      │ . >      │ / ?      │
              &kp Z    &kp X      &kp C      &kp V    &kp B   &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                              &mo 2      &mo 1        &lt 3 SPACE &lt 4 BSPC
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };  
        direction_layer_1 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │ DELETE   │ HOME     │   UP     │    END   │ INSERT   │
            &trans      &trans     &trans     &trans    &trans         &kp DEL    &kp HOME    &kp UP     &kp END    &kp INS 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │ SCROL UP │ LEFT     │ DOWN     │ RIGHT    │  TAB     │
            &tog 4      &trans     &trans     &tog 3    &trans         &trans     &kp LEFT   &kp DOWN   &kp RIGHT   &kp TAB
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │ SCROL DN │ PG_UP    │          │ PG_DN    │ CAPS     │
             &trans    &trans      &trans   &trans      &trans        &trans    &kp PG_UP   &trans     &kp PG_DN  &kp CAPS
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans          &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
        number_layer_2 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │    7     │    8     │    9     │          │
             &trans    &trans     &trans     &trans     &trans          &trans    &kp N7     &kp N8     &kp N9     &trans 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    4     │    5     │    6     │    0     │
            &trans     &trans     &trans      &tog 3     &trans          &trans    &kp N4     &kp N5     &kp N6     &kp N0
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    1     │    2     │    3     │          │
             &trans    &trans     &trans     &trans     &trans          &trans    &kp N1     &kp N2     &kp N3     &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
        function_layer_3 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │  vol dn  │   mute   │  vol up  │          │   │          │    f7    │     f8   │    f9    │    f11   │
             &trans   &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP  &trans      &trans    &kp F7     &kp F8     &kp F9     &kp F11 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │ alt + f4 │    f4    │     f5   │    f6    │    f10   │
            &trans     &trans     &trans    &trans      &trans       &kp LA(F4)    &kp F4     &kp F5     &kp F6     &kp F10
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │   prev   │  stop    │  next    │          │   │          │    f1    │     f2   │    f3    │    f12   │
             &trans   &kp C_PREV  &kp C_PP  &kp C_NEXT    &trans         &trans    &kp F1     &kp F2     &kp F3     &kp F12
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                             &to 0       &to 0         &to 0      &to 0 
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
        admin_layer_5 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ RESET    │          │          │          │          │   │          │          │          │          │  RESET   │
           &sys_reset  &trans     &trans     &trans     &trans          &trans     &trans     &trans     &trans    &sys_reset
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│BOOTLOADER│          │          │          │          │   │          │PROFILE 0 │PROFILE 1 │PROFILE 2 │BOOTLOADER│
          &bootloader  &trans     &trans     &trans      &trans       &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bootloader
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │PROFILE 3 │ PROFILE 4│          │          │
            &trans     &trans     &trans    &bt BT_CLR   &trans         &trans  &bt BT_SEL 3 &bt BT_SEL 4 &trans     &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                              &to 0      &to 0         &to 0       &to 0
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
