    #include <behaviors.dtsi>
    #include <dt-bindings/zmk/keys.h>
    #include <dt-bindings/zmk/bt.h>
    #include <dt-bindings/zmk/pointing.h>
    #define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // default: 600
    #define ZMK_POINTING_DEFAULT_SCRL_VAL 40    // default: 10



    //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
    //│  Q    0  │  W    1  │  E   2   │  R   3   │  T   4   │   │  Y   5   │  U   6   │  I   7   │  O   8   │  P   9   │
    //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    //│  A    10 │  S    11 │  D   12  │  F   13  │  G   14  │   │  H   15  │  J   16  │  K   17  │  L   18  │ ' "  19  │
    //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
    //│  Z    20 │  X    21 │  C   22  │  V   23  │  B   24  │   │  N   25  │  M   26  │ , <  27  │ . >  28  │ / ?  29  │
    //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
    //                                 │      30  │      31  │   │      32  │      33  │
    //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯



    / {
    macros {
        pl_col: pl_col {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT>;
        };
        
        pl_sort: pl_sort {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp DOT &kp S &kp O &kp R &kp T &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT>;
        };

        pl_select: pl_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp DOT &kp S &kp E &kp L &kp E &kp C &kp T>
                , <&kp LPAR &kp LBKT &kp SQT &kp SQT &kp RBKT &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_with: pl_with {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings 
                = <&kp DOT &kp W &kp I &kp T &kp H &kp UNDER &kp C &kp O &kp L &kp U &kp M &kp N &kp S>
                , <&kp LPAR &kp SPACE &kp EQUAL &kp LPAR &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR &kp RPAR &kp RPAR>;
        };


        pl_filter: pl_filter {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings
                = <&kp DOT &kp F &kp I &kp L &kp T &kp E &kp R>
                , <&kp LPAR &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR>
                , <&kp SQT &kp SQT &kp RPAR &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT>;
        };

        pl_unique: pl_unique {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp U &kp N &kp I &kp Q &kp U &kp E &kp LPAR &kp RPAR>;
        };

        pl_exclude: pl_exclude {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp S &kp E &kp L &kp E &kp C &kp T &kp LPAR>            
                , <&kp P &kp L &kp DOT &kp A &kp L &kp L &kp LPAR &kp RPAR &kp DOT>  
                , <&kp E &kp X &kp C &kp L &kp U &kp D &kp E &kp LPAR>               
                , <&kp SQT &kp SQT &kp RPAR &kp RPAR>                                
                , <&kp LEFT &kp LEFT &kp LEFT>;  
        };

        pl_not_null: pl_not_null {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp DOT &kp I &kp S &kp UNDER &kp N &kp O &kp T &kp UNDER &kp N &kp U &kp L &kp L &kp LPAR &kp RPAR>
                , <&kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT &kp LEFT> 
                , <&kp LS(LEFT) &kp LS(LEFT) &kp LS(LEFT) &kp LS(LEFT)>           
                ;
        };


        pl_collect: pl_collect {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp C &kp O &kp L &kp L &kp E &kp C &kp T &kp LPAR &kp RPAR>,
                    <&kp LEFT>;
        };

        pl_head: pl_head {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings = <&kp DOT &kp H &kp E &kp A &kp D &kp LPAR &kp RPAR>,
                    <&kp LEFT>;
        };

        pl_set_rows: pl_set_rows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp P &kp L &kp DOT &kp LS(C) &kp O &kp N &kp F &kp I &kp G &kp DOT &kp S &kp E &kp T &kp UNDER &kp T &kp B &kp L &kp UNDER &kp R &kp O &kp W &kp S &kp LPAR &kp RPAR>
                , <&kp LEFT>;
        };

        pl_group: pl_group {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp DOT &kp G &kp R &kp O &kp U &kp P &kp UNDER &kp B &kp Y &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp DOT &kp A &kp G &kp G &kp LPAR &kp EQUAL &kp SPACE &kp P &kp L &kp DOT &kp C &kp O &kp L &kp LPAR &kp SQT &kp SQT &kp RPAR &kp RPAR>;
        };

        pl_over: pl_over {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp DOT &kp O &kp V &kp E &kp R &kp LPAR &kp SQT &kp SQT &kp RPAR>
                , <&kp LEFT &kp LEFT> ;
        };

        bracket: bracket {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp LBKT &kp RBKT> ;
        };

        brace: brace {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp LBRC &kp RBRC> ;
        };

        parant: parant {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp LPAR &kp RPAR> ;
        };

        kr_thanks: kr_thanks {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp R &kp K &kp A &kp T &kp K &kp G &kp K &kp Q &kp S &kp L &kp E &kp K &kp TILDE &kp EXCL> ;
        };


        kr_hello: kr_hello {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <7>;
            tap-ms = <7>;
            bindings 
                = <&kp D &kp K &kp S &kp S &kp U &kp D &kp G &kp K &kp T &kp P &kp D &kp Y> ;
        };
    };
    combos {
        compatible = "zmk,combos";
        // k + l = ENTER
        combo_enter {
            timeout-ms = <30>;          // 동시에 눌러야 하는 제한 시간 (ms)
            key-positions = <17 18>;   // K와 L의 물리적 위치 번호
            bindings = <&kp ENTER>;     // 실행할 키
        };

            // j + k = BACKSPACE 
        combo_backspace {
            timeout-ms = <30>;  
            key-positions = <16 17>;
            bindings = <&kp BSPC>;
        };

            // h + j = cntrl + BACKSPACE 
        combo_backspace_ctrl {
            timeout-ms = <30>;
            key-positions = <16 17 18>;
            bindings = <&kp LC(BSPC)>;
        };

            // w + e = esc 
        combo_esc {
            timeout-ms = <30>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        }; 


            // d + ' = colon
        combo_COLON {
            timeout-ms = <30>;
            key-positions = <18 19>;
            bindings = <&kp COLON>;
        }; 

        
            // d + : = semicolon
        combo_SEMI {
            timeout-ms = <30>;
            key-positions = <28 29>;
            bindings = <&kp SEMI>;
        }; 


            // e + r =screen shot 
        combo_screenshot {
            timeout-ms = <30>;
            key-positions = <2 3>; 
            bindings = <&kp LS(LG(S))>;   
        };  

            // left shift + ㅂ = ㅃ 
        combo_shiftq {
            timeout-ms = <30>;
            key-positions = <18 0>; 
            bindings = <&kp LS(Q)>;   
        };  

            // left shift + ㅈ = ㅉ 
        combo_shiftw {
            timeout-ms = <30>;
            key-positions = <18 1>; 
            bindings = <&kp LS(W)>;   
        };  

            // left shift + ㄷ = ㄸ 
        combo_shifte {
            timeout-ms = <30>;
            key-positions = <18 2>; 
            bindings = <&kp LS(E)>;   
        };  

            // left shift + ㄱ = ㄲ 
        combo_shiftr {
            timeout-ms = <30>;
            key-positions = <18 3>; 
            bindings = <&kp LS(R)>;   
        };  

            // left shift + ㅅ = ㅆ 
        combo_shiftt {
            timeout-ms = <30>;
            key-positions = <18 4>; 
            bindings = <&kp LS(T)>;   
        };  
    };
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            // require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        layer_tab: layer_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            // 홀드 시 첫 번째 인자(&mo), 탭 시 두 번째 인자(&to) 실행
            bindings = <&mo>, <&kp>;
        };

        to_mo: to_mo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";    // 짧게 누르기 반응성을 높임
            tapping-term-ms = <200>;     
            bindings = <&mo>, <&to>;     // 순서: [Hold 시 동작], [Tap 시 동작]
        };

        td_cut: tap_dance_cut {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_CUT";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp X>, <&kp LC(X)>;
        };

        // 복사 (c 한 번: c, 두 번: Ctrl+C)
        td_copy: tap_dance_copy {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_COPY";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C>, <&kp LC(C)>;
        };

        // 붙여넣기 (v 한 번: v, 두 번: Ctrl+V)
        td_paste: tap_dance_paste {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_PASTE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp V>, <&kp LC(V)>;
        };

    }; 
    keymap {
        compatible = "zmk,keymap";
        default_layer_0 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│  Q       │  W       │  E       │  R       │  T       │   │  Y       │  U       │  I       │  O       │  P       │
            &kp Q         &kp W   &kp E     &kp R      &kp T         &kp Y      &kp U        &kp I      &kp O    &kp P
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  A       │  S       │  D       │  F       │  G       │   │  H       │  J       │  K       │  L       │ ' "      │
            &ht LCTRL A &ht LSHFT S &ht LALT D &lt 4 F &ht LGUI G     &ht CAPS H  &lt 5 J &ht LALT K &ht RSHFT L &ht LCTRL SQT
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│  Z       │  X       │  C       │  V       │  B       │   │  N       │  M       │ , <      │ . >      │ / ?      │
            &kp Z      &td_cut    &td_copy   &td_paste   &kp B          &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                        &to_mo 3 2    &layer_tab 1 TAB  &lt 3 SPACE  &layer_tab 6 RALT
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };                 
        direction_layer_1 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │ DELETE   │          │   UP     │          │ INSERT   │
            &trans      &trans   &msc SCRL_UP &trans       &trans      &kp DEL    &kp PG_UP    &kp UP  &kp PG_DN    &kp INS 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │ LEFT     │ DOWN     │ RIGHT    │          │
            &trans   &trans  &msc SCRL_LEFT &msc SCRL_RIGHT &trans     &kp HOME  &kp LEFT  &kp DOWN   &kp RIGHT   &kp END 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
            &trans     &trans   &msc SCRL_DOWN &trans    &trans         &trans  &msc SCRL_UP &msc SCRL_DOWN &trans &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &trans     &trans         &mkp LCLK  &mkp RCLK
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
        mouse_layer_2 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │          │          │          │          │
        &kp C_MUTE      &trans     &trans     &trans     &trans       &kp LC(W) &kp LC(PG_UP) &mmv MOVE_UP &kp LC(PG_DN) &kp F11
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
        &kp C_VOL_UP  &trans  &msc SCRL_LEFT &msc SCRL_RIGHT &trans &kp LEFT  &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp RIGHT 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │          │          │          │          │
        &kp C_VOL_DN &kp C_PREV    &kp C_PP &kp C_NEXT   &trans       &kp LA(LEFT) &msc SCRL_UP &msc SCRL_DOWN &kp F &kp LA(RIGHT)  
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &to 0   &mkp LCLK      &mkp LCLK  &mkp RCLK
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        number_layer_3 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│          │          │          │          │          │   │          │    7     │    8     │    9     │          │
           &kp C_MUTE   &kp F7     &kp F8     &kp F9    &kp F11       &kp MINUS    &kp N7     &kp N8     &kp N9     &kp PLUS 
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    4     │    5     │    6     │    0     │
        &ht LCTRL C_VOL_UP &ht LSHFT F4 &ht LALT F5 &kp F6 &kp F10     &trans    &kp N4   &ht LALT N5 &ht RSHFT N6 &ht LCTRL N0
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │    1     │    2     │    3     │          │
          &kp C_VOL_DN  &kp F1     &kp F2     &kp F3    &kp F12        &kp ASTRK    &kp N1     &kp N2     &kp N3     &kp FSLH
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &trans     &trans         &trans     &trans
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };

        special_layer_4 {
            bindings = <
            &kp GRAVE &trans &trans &trans &trans   &kp TILDE &kp EXCL &kp AT &kp HASH &kp PLUS 
            &trans &trans &trans &trans &trans   &kp MINUS &kp UNDER &kp EQUAL &kp CARET &kp ASTRK
            &kp LBRC &kp RBRC &kp COLON &trans &kp SEMI   &kp AMPS &kp DLLR &kp BSLH &kp PIPE &kp PRCNT 
            &kp LBKT &kp RBKT &kp LPAR &kp RPAR
            >;
        };

        macro_layer_5 {
            bindings = <
            &pl_unique &pl_with &pl_exclude &pl_set_rows &pl_head   &trans &trans &trans &trans &trans 
            &pl_sort &pl_select &pl_col &pl_filter &pl_group   &trans &trans &parant &bracket &brace 
            &kr_hello &pl_not_null &pl_collect &pl_over &kr_thanks   &trans &trans &trans &trans &trans 
            &trans &trans &trans &trans
            >;
        };

        admin_layer_6 {
            bindings = <
        //╭──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────╮
        //│ RESET    │          │          │          │          │   │          │          │          │          │  RESET   │
            &sys_reset  &trans     &trans     &trans     &trans          &trans     &trans     &trans     &trans    &sys_reset
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│BOOTLOADER│          │          │          │          │   │          │PROFILE 0 │PROFILE 1 │PROFILE 2 │BOOTLOADER│
            &bootloader  &trans     &trans     &trans      &trans       &trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bootloader
        //├──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┤
        //│          │          │          │          │          │   │          │PROFILE 3 │ PROFILE 4│          │          │
            &trans     &trans     &trans    &bt BT_CLR   &trans         &trans  &bt BT_SEL 3 &bt BT_SEL 4 &trans     &trans
        //╰──────────┴──────────┴──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┴──────────┴──────────╯
                                                &trans     &trans        &trans     &trans 
        //                                 ╰──────────┴──────────╯   ╰──────────┴──────────╯
            >;
        };
    };
};
